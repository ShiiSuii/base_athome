# ROS 2 build directories
build/
!tools/urdf_editor/static/vendor/three/build/
!tools/urdf_editor/static/vendor/three/build/**
install/
log/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Editor and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Large datasets, maps and bag recordings
*.bag
*.db3
*.db
*.pgm

# Large neural network models and binary weights
*.onnx
*.caffemodel
*.pt
*.pkl


# Biometria (memoria facial): nunca versionar. Vive en ~/.local/share/base_athome/faces_database
src/base_athome_perception/config/faces_database/

# Mapas generados de los mundos de simulacion: hacen falta para correr Nav2 en un clon nuevo
!simulation/config/*.pgm

# Grafo de graphify: se regenera local
graphify-out/
.claude/settings.json.graphify-bak

# Pesos de modelos y paquetes generados (no se versionan)
weights/
*.zip
tdp/**/main.pdf
# Worktrees de agentes locales
.claude/worktrees/
