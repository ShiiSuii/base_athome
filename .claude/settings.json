{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git worktree list *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(python3 -m pytest *)",
      "Bash(pytest *)",
      "Bash(colcon test *)",
      "Bash(colcon test-result *)",
      "Bash(ros2 node list)",
      "Bash(ros2 topic list *)",
      "Bash(ros2 topic info *)",
      "Bash(ros2 service list *)",
      "Bash(ros2 action list *)",
      "Bash(ros2 param list *)",
      "Bash(xacro *)",
      "Bash(check_urdf *)",
      "Bash(systemctl --user status *)",
      "Bash(journalctl --user *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(sudo *)",
      "Bash(systemctl *)",
      "Bash(loginctl *)",
      "Bash(ros2 launch *)",
      "Bash(ros2 topic pub *)",
      "Bash(ros2 service call *)",
      "Bash(ros2 action send_goal *)",
      "Bash(ros2 lifecycle set *)",
      "Bash(ros2 bag record *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(apt *)",
      "Bash(apt-get *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*credentials*)",
      "Read(./**/*token*)",
      "Read(./**/*secret*)",
      "Bash(roscore *)",
      "Bash(rosrun *)",
      "Bash(roslaunch *)",
      "Bash(catkin_make *)",
      "Bash(catkin build *)",
      "Bash(ros1_bridge *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}