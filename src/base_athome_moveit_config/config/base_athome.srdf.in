<?xml version="1.0"?>
<robot name="base_athome">
  <!-- Grupo del brazo: cadena desde la base del Piper hasta el TCP (yemas de la pinza) -->
  <group name="arm">
    <chain base_link="arm_base_link" tip_link="tcp_link"/>
  </group>
  <group name="gripper">
    <joint name="joint7"/>
    <joint name="joint8"/>
  </group>
  <group_state name="home" group="arm">
    <joint name="joint1" value="1.5179"/>
    <joint name="joint2" value="3.0171"/>
    <joint name="joint3" value="-2.8384"/>
    <joint name="joint4" value="-1.7434"/>
    <joint name="joint5" value="-0.0119"/>
    <joint name="joint6" value="0.7850"/>
  </group_state>
  <end_effector name="gripper" parent_link="link6" group="gripper" parent_group="arm"/>
  <!-- Joints que MoveIt no planifica (los mueven otros nodos) -->
  <passive_joint name="pan_joint"/>
  <passive_joint name="tilt_joint"/>
  <passive_joint name="torso_lift_joint"/>
  <!--ACM-->
</robot>
