Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Reference Frame: map
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Mapa
      Topic: {Value: /map, Durability Policy: Transient Local}
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Description Topic: {Value: /robot_description}
      Enabled: true
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Topic: {Value: /scan, Reliability Policy: Best Effort}
      Size (m): 0.04
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Objeto simulado
      Topic: {Value: /sim/world}
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Objeto detectado
      Topic: {Value: /arm_camera/object_markers}
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Camara cabeza
      Topic: {Value: /camera/camera/color/image_raw, Reliability Policy: Best Effort}
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Camara muneca
      Topic: {Value: /arm_camera/image_raw, Reliability Policy: Best Effort}
      Enabled: true
  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/SetGoal
      Topic: {Value: /goal_pose}
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: base_link   # la camara sigue al robot (el mapa queda fijo en el mundo)
      Distance: 2.5
      Focal Point: {X: 0.2, Y: 0.0, Z: 0.8}
      Pitch: 0.6
      Yaw: 3.6
