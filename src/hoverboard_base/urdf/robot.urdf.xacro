<?xml version="1.0"?>
<!-- Robot RoboCup @Home (base hoverboard + torso elevador + pan-tilt con RealSense D435 + brazo Piper).
     Archivo principal: solo incluye los modulos. Las rutas son relativas a este archivo.
     Compilar con scripts/build_urdf.sh (genera robot.urdf, que es el que cargan los launch). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_athome">

  <!-- properties.xacro va PRIMERO: sus propiedades deben ser visibles en los demas modulos -->
  <xacro:include filename="xacro/properties.xacro"/>
  <xacro:include filename="xacro/materials.xacro"/>
  <xacro:include filename="xacro/base.xacro"/>
  <xacro:include filename="xacro/torso.xacro"/>
  <xacro:include filename="xacro/head.xacro"/>
  <xacro:include filename="xacro/arm_piper.xacro"/>

</robot>
