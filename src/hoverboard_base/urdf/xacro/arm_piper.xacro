<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Brazo AgileX Piper 6-DOF + gripper + camara de muneca Orbbec DaBai. -->

  <!-- ==================== BRAZO ROBÓTICO AGILEX PIPER 6-DOF ==================== -->
  <!-- Montaje rígido sobre la cara superior del cubo estructural ubicado a la izquierda (+Y) -->
  <link name="arm_base_link">
    <inertial>
      <origin xyz="-0.00473 2.568e-05 0.04145" rpy="0 0 0" />
      <mass value="1.02" />
      <inertia ixx="0.00267" ixy="-0.0000007" ixz="-0.00017" iyy="0.00282" iyz="0.0000004" izz="0.00089" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/base_link.STL" />
      </geometry>
      <material name="piper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Montaje sobre el lado lateral izquierdo del prisma del torso, retrasado 15 cm hacia atrás y calibrado a 85 cm de altura del gripper -->
  <joint name="cube_to_arm_joint" type="fixed">
    <parent link="mounting_cube_link"/>
    <child link="arm_base_link"/>
    <origin xyz="-0.15 ${prism_size_y / 2.0} -0.11" rpy="-1.5707963 0 0"/>
  </joint>

  <!-- Link 1 (Joint 1 - Rotación en Z) -->
  <link name="link1">
    <inertial>
      <origin xyz="0.00032 -0.00041 -0.00348" rpy="0 0 0" />
      <mass value="0.71" />
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0004" iyz="0.0" izz="0.00045" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link1.STL" />
      </geometry>
      <material name="piper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link1.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.123" rpy="0 0 0" />
    <parent link="arm_base_link" />
    <child link="link1" />
    <axis xyz="0 0 1" />
    <limit lower="-2.688" upper="2.688" effort="100" velocity="5" />
  </joint>

  <!-- Link 2 (Joint 2 - Hombro en Y) -->
  <link name="link2">
    <inertial>
      <origin xyz="0.21852 -0.00861 0.00126" rpy="0 0 0" />
      <mass value="1.16" />
      <inertia ixx="0.0011" ixy="0.0018" ixz="0.00019" iyy="0.0676" iyz="0.0" izz="0.0675" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link2.STL" />
      </geometry>
      <material name="piper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link2.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 -0.1359 -3.1416" />
    <parent link="link1" />
    <child link="link2" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="3.403" effort="100" velocity="5" />
  </joint>

  <!-- Link 3 (Joint 3 - Codo) -->
  <link name="link3">
    <inertial>
      <origin xyz="-0.01999 -0.14808 -0.00053" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.01347608" ixy="0.00161034" ixz="0.00000066" iyy="0.00046377" iyz="0.00000162" izz="0.01363321" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link3.STL" />
      </geometry>
      <material name="piper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link3.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint3" type="revolute">
    <origin xyz="0.28503 0 0" rpy="0 0 -1.7939" />
    <parent link="link2" />
    <child link="link3" />
    <axis xyz="0 0 1" />
    <limit lower="-3.054" upper="0" effort="100" velocity="5" />
  </joint>

  <!-- Link 4 (Joint 4 - Muñeca Roll) -->
  <link name="link4">
    <inertial>
      <origin xyz="0.00013 -0.00076 -0.00394" rpy="0 0 0" />
      <mass value="0.38" />
      <inertia ixx="0.00017844" ixy="0.00000062" ixz="0.00000067" iyy="0.00018914" iyz="0.00000408" izz="0.00014613" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link4.STL" />
      </geometry>
      <material name="piper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link4.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint4" type="revolute">
    <origin xyz="-0.021984 -0.25075 0" rpy="1.5708 0 0" />
    <parent link="link3" />
    <child link="link4" />
    <axis xyz="0 0 1" />
    <limit lower="-1.920" upper="1.920" effort="100" velocity="5" />
  </joint>

  <!-- Link 5 (Joint 5 - Muñeca Pitch) -->
  <link name="link5">
    <inertial>
      <origin xyz="0.00018 -0.06104 -0.00227" rpy="0 0 0" />
      <mass value="0.383" />
      <inertia ixx="0.00172318" ixy="0.00000259" ixz="0.00000010" iyy="0.00017936" iyz="0.00000990" izz="0.00171172" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link5.STL" />
      </geometry>
      <material name="piper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link5.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint5" type="revolute">
    <origin xyz="0 0 0" rpy="-1.5708 0 0" />
    <parent link="link4" />
    <child link="link5" />
    <axis xyz="0 0 1" />
    <limit lower="-1.396" upper="1.396" effort="100" velocity="5" />
  </joint>

  <!-- Link 6 (Joint 6 - Giro Extremo Muñeca) -->
  <link name="link6">
    <inertial>
      <origin xyz="-0.00003 0.00006 0.04618" rpy="0 0 0" />
      <mass value="0.007" />
      <inertia ixx="0.00152112" ixy="0.00000202" ixz="0.00000261" iyy="0.00138626" iyz="0.00000002" izz="0.00031152" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link6.STL" />
      </geometry>
      <material name="piper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link6.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint6" type="revolute">
    <origin xyz="8.8259E-05 -0.091 0" rpy="1.5708 0 0" />
    <parent link="link5" />
    <child link="link6" />
    <axis xyz="0 0 1" />
    <limit lower="-3.142" upper="3.142" effort="100" velocity="3" />
  </joint>

  <!-- Punto Central de Herramienta (TCP) entre los dedos de la pinza -->
  <link name="tcp_link"/>
  <joint name="link6_to_tcp_joint" type="fixed">
    <origin xyz="0 0 0.1358" rpy="0 0 0" />
    <parent link="link6" />
    <child link="tcp_link" />
  </joint>

  <!-- Pinza Paralela: Base de la Pinza -->
  <link name="gripper_base">
    <inertial>
      <origin xyz="0.00021 0.00032 0.045" rpy="0 0 0" />
      <mass value="0.15" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/gripper_base.STL" />
      </geometry>
      <material name="piper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/gripper_base.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint6_to_gripper_base" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="link6" />
    <child link="gripper_base" />
  </joint>

  <!-- Dedo Izquierdo Pinza (Joint 7 - Prismático) -->
  <link name="link7">
    <inertial>
      <origin xyz="0.00065 -0.04919 0.00972" rpy="0 0 0" />
      <mass value="0.025" />
      <inertia ixx="0.00007" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00007" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link7.STL" />
      </geometry>
      <material name="piper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link7.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint7" type="prismatic">
    <origin xyz="0 0 0.1358" rpy="1.5708 0 0" />
    <parent link="gripper_base" />
    <child link="link7" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="0.0525" effort="10" velocity="1" />
  </joint>

  <!-- Dedo Derecho Pinza (Joint 8 - Prismático) -->
  <link name="link8">
    <inertial>
      <origin xyz="0.00065 -0.04919 0.00972" rpy="0 0 0" />
      <mass value="0.025" />
      <inertia ixx="0.00007" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00007" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link8.STL" />
      </geometry>
      <material name="piper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link8.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint8" type="prismatic">
    <origin xyz="0 0 0.1358" rpy="1.5708 0 -3.1416" />
    <parent link="gripper_base" />
    <child link="link8" />
    <axis xyz="0 0 -1" />
    <limit lower="-0.0525" upper="0" effort="10" velocity="1" />
  </joint>

  <!-- Cámara de Muñeca Orbbec DaBai DC1 (Eye-in-Hand) -->
  <link name="arm_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.090 0.025"/>
      </geometry>
      <material name="orbbec_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.090 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="arm_camera_mount_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="arm_camera_link"/>
    <!-- Camara del brazo montada 8cm hacia atras y perfectamente centrada (y=0.0) -->
    <origin xyz="0.025 0.0 0.00" rpy="0 0 0"/>
  </joint>

  <!-- Marco Óptico Orbbec DaBai (Estándar ROS: Z adelante, X derecha, Y abajo) -->
  <link name="arm_camera_optical_frame"/>
  <joint name="arm_camera_optical_joint" type="fixed">
    <parent link="arm_camera_link"/>
    <child link="arm_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>


</robot>
