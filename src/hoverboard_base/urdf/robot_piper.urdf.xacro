<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_athome">

  <!-- ==================== PROPIEDADES CONFIGURABLES ==================== -->
  <xacro:property name="chassis_length" value="0.48"/>
  <xacro:property name="chassis_width"  value="0.48"/>
  <xacro:property name="chassis_height" value="0.05"/>
  <xacro:property name="ground_clearance" value="0.04"/>

  <!-- Distancia efectiva calibrada entre ruedas: 56.20 cm -> offset Y = +/- 0.281m -->
  <xacro:property name="track_width"    value="0.5620"/>
  <xacro:property name="wheel_radius"   value="0.0853"/>
  <xacro:property name="wheel_width"    value="0.055"/>
  <xacro:property name="wheel_offset_x" value="0.095"/>

  <!-- Rueda loca trasera -->
  <xacro:property name="caster_offset_x" value="-0.20"/>
  <xacro:property name="caster_radius"   value="0.04"/>

  <!-- Sensor LiDAR Hokuyo -->
  <xacro:property name="laser_offset_x" value="0.22"/>
  <xacro:property name="laser_offset_y" value="0.00"/>
  <xacro:property name="laser_offset_z" value="0.18"/>

  <!-- Sistema de Elevación Torso / Columna (Exactamente en el medio de la base, 1.0 m altura) -->
  <xacro:property name="column_x"               value="0.0"/>
  <xacro:property name="column_y"               value="0.0"/>
  <xacro:property name="column_height"          value="1.0"/>
  <xacro:property name="column_width"           value="0.06"/>
  <xacro:property name="column_collision_width" value="0.08"/>

  <!-- Plataforma de Elevación (Carriage / torso_lift_link) -->
  <xacro:property name="carriage_length"        value="0.22"/>
  <xacro:property name="carriage_width"         value="0.38"/>
  <xacro:property name="carriage_height"        value="0.02"/>

  <!-- Prisma Estructural del Torso de Subir y Bajar (35 cm ancho x 25 cm profundidad x 35 cm alto) -->
  <xacro:property name="prism_size_x"           value="0.25"/> <!-- 25 cm hacia adelante desde la pared frontal del elevador -->
  <xacro:property name="prism_size_y"           value="0.35"/> <!-- 35 cm horizontal transversal contra el elevador -->
  <xacro:property name="prism_size_z"           value="0.35"/> <!-- 35 cm altura del prisma (cubo de 35 cm de ancho y alto) -->
  <xacro:property name="prism_gap_to_pantilt"   value="0.12"/> <!-- 12 cm hacia abajo de la base del pan-tilt -->
  
  <!-- Base del Cabezal Pan-Tilt (Sobre el elevador, referencia superior) -->
  <xacro:property name="head_base_x"            value="${column_width / 2.0 + 0.04}"/>
  <xacro:property name="head_base_y"            value="0.0"/>
  <xacro:property name="head_base_z"            value="0.12"/>

  <!-- Posicion del Prisma respecto a torso_lift_link -->
  <xacro:property name="prism_offset_x"         value="${column_width / 2.0 + prism_size_x / 2.0}"/>
  <xacro:property name="prism_offset_y"         value="0.0"/>
  <xacro:property name="prism_offset_z"         value="${head_base_z - prism_gap_to_pantilt - prism_size_z / 2.0}"/>

  <!-- Pantalla interactiva / Tablet HRI de expresión facial (Montada en el centro frontal del prisma) -->
  <xacro:property name="screen_depth"           value="0.04"/>
  <xacro:property name="screen_width"           value="0.26"/>
  <xacro:property name="screen_height"          value="0.18"/>
  <xacro:property name="screen_offset_x"        value="${column_width / 2.0 + prism_size_x + screen_depth / 2.0}"/>
  <xacro:property name="screen_offset_y"        value="0.0"/>
  <xacro:property name="screen_offset_z"        value="${prism_offset_z}"/>

  <!-- ==================== MATERIALES ==================== -->
  <material name="chassis_blue">
    <color rgba="0.15 0.45 0.85 0.95"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>
  <material name="laser_red">
    <color rgba="0.90 0.10 0.10 1.0"/>
  </material>
  <material name="caster_gray">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>
  <material name="column_aluminum">
    <color rgba="0.65 0.65 0.70 1.0"/>
  </material>
  <material name="cube_metallic">
    <color rgba="0.28 0.30 0.35 1.0"/>
  </material>
  <material name="pantilt_dark">
    <color rgba="0.18 0.18 0.18 1.0"/>
  </material>
  <material name="screen_black">
    <color rgba="0.06 0.07 0.09 1.0"/>
  </material>
  <material name="screen_cyan">
    <color rgba="0.0 0.82 1.0 0.95"/>
  </material>
  <material name="realsense_silver">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>
  <material name="piper_gray">
    <color rgba="0.75 0.78 0.88 1.0"/>
  </material>
  <material name="orbbec_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <!-- ==================== BASE FOOTPRINT ==================== -->
  <link name="base_footprint"/>

  <!-- ==================== CHASIS ==================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${ground_clearance + chassis_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${ground_clearance + chassis_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${ground_clearance + chassis_height / 2.0}" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.233" ixy="0.0" ixz="0.0" iyy="0.233" iyz="0.0" izz="0.461"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Macro para ruedas -->
  <xacro:macro name="hover_wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_wheel_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${wheel_offset_x} ${y_reflect * track_width / 2.0} ${wheel_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:hover_wheel prefix="left" y_reflect="1"/>
  <xacro:hover_wheel prefix="right" y_reflect="-1"/>

  <!-- Rueda loca trasera -->
  <link name="rear_caster">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="caster_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="${caster_offset_x} 0.0 ${caster_radius}" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR Hokuyo -->
  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.05"/>
      </geometry>
      <material name="laser_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="${laser_offset_x} ${laser_offset_y} ${laser_offset_z}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== SISTEMA DE SUBIR Y BAJAR (TORSO VERTICAL) ==================== -->
  <link name="torso_column">
    <visual>
      <origin xyz="0 0 ${column_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${column_width} ${column_width} ${column_height}"/>
      </geometry>
      <material name="column_aluminum"/>
    </visual>
    <!-- Envolvente de colisión completa de la columna vertical central para MoveIt -->
    <collision>
      <origin xyz="0 0 ${column_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${column_collision_width} ${column_collision_width} ${column_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${column_height / 2.0}" rpy="0 0 0"/>
      <mass value="3.5"/>
      <inertia ixx="0.292" ixy="0.0" ixz="0.0" iyy="0.292" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="torso_column_joint" type="fixed">
    <parent link="base_link"/>
    <child link="torso_column"/>
    <origin xyz="${column_x} ${column_y} ${ground_clearance + chassis_height}" rpy="0 0 0"/>
  </joint>

  <!-- Plataforma superior móvil del elevador (Carriage) -->
  <link name="torso_lift_link">
    <visual>
      <origin xyz="0.03 0.06 0" rpy="0 0 0"/>
      <geometry>
        <box size="${carriage_length} ${carriage_width} ${carriage_height}"/>
      </geometry>
      <material name="pantilt_dark"/>
    </visual>
    <!-- Geometría de colisión de la plataforma del elevador para MoveIt -->
    <collision>
      <origin xyz="0.03 0.06 0" rpy="0 0 0"/>
      <geometry>
        <box size="${carriage_length} ${carriage_width} ${carriage_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.03 0.06 0" rpy="0 0 0"/>
      <mass value="1.8"/>
      <inertia ixx="0.021" ixy="0.0" ixz="0.0" iyy="0.007" iyz="0.0" izz="0.028"/>
    </inertial>
  </link>

  <joint name="torso_lift_joint" type="fixed">
    <parent link="torso_column"/>
    <child link="torso_lift_link"/>
    <origin xyz="0 0 ${column_height}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== PRISMA ESTRUCTURAL DEL TORSO (SUBIR Y BAJAR) ==================== -->
  <!-- Prisma de 35 cm ancho (Y) x 25 cm profundidad hacia adelante (X) x 35 cm alto (Z) -->
  <link name="mounting_cube_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${prism_size_x} ${prism_size_y} ${prism_size_z}"/>
      </geometry>
      <material name="cube_metallic"/>
    </visual>
    <!-- Geometría de colisión volumétrica completa del torso para MoveIt -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${prism_size_x} ${prism_size_y} ${prism_size_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.081" ixy="0.0" ixz="0.0" iyy="0.061" iyz="0.0" izz="0.061"/>
    </inertial>
  </link>

  <joint name="torso_lift_to_cube_joint" type="fixed">
    <parent link="torso_lift_link"/>
    <child link="mounting_cube_link"/>
    <origin xyz="${prism_offset_x} ${prism_offset_y} ${prism_offset_z}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== PANTALLA INTERACTIVA HRI (ROSTRO ANIMADO) ==================== -->
  <!-- Pantalla ubicada en el centro frontal del elevador, mostrando la cara interactiva -->
  <link name="screen_link">
    <visual>
      <!-- Marco / Bisel exterior de la pantalla -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${screen_depth} ${screen_width} ${screen_height}"/>
      </geometry>
      <material name="screen_black"/>
    </visual>
    <visual>
      <!-- Superficie del display emisor (rostro cyan OLED) -->
      <origin xyz="${screen_depth / 2.0 + 0.001} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.002 ${screen_width - 0.02} ${screen_height - 0.02}"/>
      </geometry>
      <material name="screen_cyan"/>
    </visual>
    <!-- Envolvente de colisión completa de la pantalla para MoveIt -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${screen_depth + 0.01} ${screen_width + 0.01} ${screen_height + 0.01}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.009" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.011"/>
    </inertial>
  </link>

  <joint name="torso_lift_to_screen_joint" type="fixed">
    <parent link="torso_lift_link"/>
    <child link="screen_link"/>
    <origin xyz="${screen_offset_x} ${screen_offset_y} ${screen_offset_z}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== SISTEMA PAN-TILT ==================== -->
  <link name="pan_tilt_base_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.03"/>
      </geometry>
      <material name="pantilt_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="pan_tilt_base_joint" type="fixed">
    <parent link="torso_lift_link"/>
    <child link="pan_tilt_base_link"/>
    <origin xyz="${head_base_x} ${head_base_y} ${head_base_z}" rpy="0 0 0"/>
  </joint>

  <!-- Motor 1: Pan Joint (Giro Horizontal en Z) -->
  <link name="pan_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.045 0.05"/>
      </geometry>
      <material name="pantilt_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.045 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="pan_joint" type="revolute">
    <parent link="pan_tilt_base_link"/>
    <child link="pan_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="2.5" velocity="3.14"/>
  </joint>

  <!-- Motor 2: Tilt Joint (Inclinación Vertical en Y) -->
  <link name="tilt_link">
    <visual>
      <origin xyz="0.015 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.10 0.03"/>
      </geometry>
      <material name="pantilt_dark"/>
    </visual>
    <collision>
      <origin xyz="0.015 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.10 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.015 0 0.01" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="tilt_joint" type="revolute">
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7854" upper="0.7854" effort="2.5" velocity="3.14"/>
  </joint>

  <!-- Cámara RealSense D435 en Cabezal -->
  <joint name="camera_mount_joint" type="fixed">
    <parent link="tilt_link"/>
    <child link="camera_link"/>
    <origin xyz="0.035 0.0 0.015" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
      <material name="realsense_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.072"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- Marco Óptico RealSense (Estándar ROS: Z adelante, X derecha, Y abajo) -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <!-- ==================== BRAZO ROBÓTICO AGILEX PIPER 6-DOF ==================== -->
  <!-- Montaje rígido sobre la cara superior del cubo estructural ubicado a la izquierda (+Y) -->
  <link name="arm_base_link">
    <inertial>
      <origin xyz="-0.00473 2.568e-05 0.04145" rpy="0 0 0" />
      <mass value="1.02" />
      <inertia ixx="0.00267" ixy="-0.0000007" ixz="-0.00017" iyy="0.00282" iyz="0.0000004" izz="0.00089" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/base_link.STL" />
      </geometry>
      <material name="piper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Montaje sobre el lado lateral izquierdo del prisma del torso, como un brazo humano en el hombro -->
  <joint name="cube_to_arm_joint" type="fixed">
    <parent link="mounting_cube_link"/>
    <child link="arm_base_link"/>
    <origin xyz="0.0 ${prism_size_y / 2.0} 0.10" rpy="-1.5707963 0 0"/>
  </joint>

  <!-- Link 1 (Joint 1 - Rotación en Z) -->
  <link name="link1">
    <inertial>
      <origin xyz="0.00032 -0.00041 -0.00348" rpy="0 0 0" />
      <mass value="0.71" />
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0004" iyz="0.0" izz="0.00045" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link1.STL" />
      </geometry>
      <material name="piper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link1.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.123" rpy="0 0 0" />
    <parent link="arm_base_link" />
    <child link="link1" />
    <axis xyz="0 0 1" />
    <limit lower="-2.688" upper="2.688" effort="100" velocity="5" />
  </joint>

  <!-- Link 2 (Joint 2 - Hombro en Y) -->
  <link name="link2">
    <inertial>
      <origin xyz="0.21852 -0.00861 0.00126" rpy="0 0 0" />
      <mass value="1.16" />
      <inertia ixx="0.0011" ixy="0.0018" ixz="0.00019" iyy="0.0676" iyz="0.0" izz="0.0675" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link2.STL" />
      </geometry>
      <material name="piper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link2.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 -0.1359 -3.1416" />
    <parent link="link1" />
    <child link="link2" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="3.403" effort="100" velocity="5" />
  </joint>

  <!-- Link 3 (Joint 3 - Codo) -->
  <link name="link3">
    <inertial>
      <origin xyz="-0.01999 -0.14808 -0.00053" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.01347608" ixy="0.00161034" ixz="0.00000066" iyy="0.00046377" iyz="0.00000162" izz="0.01363321" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link3.STL" />
      </geometry>
      <material name="piper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://piper_description/meshes/link3.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint3" type="revolute">
    <origin xyz="0.28503 0 0" rpy="0 0 -1.7939" />
    <parent link="link2" />
    <child link="link3" />
    <axis xyz="0 0 1" />
    <limit lower="-3.054" upper="0" effort="100" velocity="5" />
  </joint>

  <!-- Link 4 (Joint 4 - Muñeca Roll) -->
  <link name="link4">
    <inertial>
      <origin xyz="0.00013 -0.00076 -0.00394" rpy="0 0 0" />
      <mass value="0.38" />
