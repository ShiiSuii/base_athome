<?xml version="1.0"?>
<!-- Mundo para Pick and Place en simulacion (gz sim Harmonic):
     mesa, estante, lavavajillas y tacho de basura representados como cajas estaticas
     sin mallas externas, con dimensiones normativas de RoboCup@Home. -->
<sdf version="1.9">
  <world name="casa_pick_place">
    <physics name="1ms" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light type="directional" name="sol"><cast_shadows>false</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.3 0.2 -1</direction></light>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.8 0.85 0.9 1</background></scene>

    <model name="piso"><static>true</static><link name="l">
      <collision name="col_piso"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
      <visual name="vis_piso"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        <material><diffuse>0.55 0.5 0.45 1</diffuse><ambient>0.55 0.5 0.45 1</ambient></material></visual></link></model>

    <!-- Paredes: habitacion 8 x 6 m, puerta (hueco de 1 m) en la pared oeste -->
    <model name="paredes"><static>true</static><link name="l">
      <collision name="col_n"><pose>1 3 0.6 0 0 0</pose><geometry><box><size>8 0.1 1.2</size></box></geometry></collision>
      <visual name="vis_n"><pose>1 3 0.6 0 0 0</pose><geometry><box><size>8 0.1 1.2</size></box></geometry></visual>
      <collision name="col_s"><pose>1 -3 0.6 0 0 0</pose><geometry><box><size>8 0.1 1.2</size></box></geometry></collision>
      <visual name="vis_s"><pose>1 -3 0.6 0 0 0</pose><geometry><box><size>8 0.1 1.2</size></box></geometry></visual>
      <collision name="col_e"><pose>5 0 0.6 0 0 0</pose><geometry><box><size>0.1 6 1.2</size></box></geometry></collision>
      <visual name="vis_e"><pose>5 0 0.6 0 0 0</pose><geometry><box><size>0.1 6 1.2</size></box></geometry></visual>
      <collision name="col_w1"><pose>-3 1.75 0.6 0 0 0</pose><geometry><box><size>0.1 2.5 1.2</size></box></geometry></collision>
      <visual name="vis_w1"><pose>-3 1.75 0.6 0 0 0</pose><geometry><box><size>0.1 2.5 1.2</size></box></geometry></visual>
      <collision name="col_w2"><pose>-3 -1.75 0.6 0 0 0</pose><geometry><box><size>0.1 2.5 1.2</size></box></geometry></collision>
      <visual name="vis_w2"><pose>-3 -1.75 0.6 0 0 0</pose><geometry><box><size>0.1 2.5 1.2</size></box></geometry></visual>
    </link></model>

    <!-- Mesa de comedor: 0.8 x 1.2 x 0.76 m -->
    <model name="mesa"><static>true</static><pose>2.0 -1.5 0 0 0 0</pose><link name="l">
      <collision name="col_mesa"><pose>0 0 0.38 0 0 0</pose><geometry><box><size>0.8 1.2 0.76</size></box></geometry></collision>
      <visual name="vis_mesa"><pose>0 0 0.38 0 0 0</pose><geometry><box><size>0.8 1.2 0.76</size></box></geometry>
        <material><diffuse>0.45 0.3 0.15 1</diffuse><ambient>0.45 0.3 0.15 1</ambient></material></visual></link></model>

    <!-- Estante de almacenamiento: 0.9 x 0.4 x 1.4 m -->
    <model name="estante"><static>true</static><pose>0.0 2.7 0 0 0 0</pose><link name="l">
      <collision name="col_estante"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>0.9 0.4 1.4</size></box></geometry></collision>
      <visual name="vis_estante"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>0.9 0.4 1.4</size></box></geometry>
        <material><diffuse>0.3 0.25 0.2 1</diffuse><ambient>0.3 0.25 0.2 1</ambient></material></visual></link></model>

    <!-- Lavavajillas: 0.6 x 0.6 x 0.85 m -->
    <model name="lavavajillas"><static>true</static><pose>3.0 2.65 0 0 0 0</pose><link name="l">
      <collision name="col_lavavajillas"><pose>0 0 0.425 0 0 0</pose><geometry><box><size>0.6 0.6 0.85</size></box></geometry></collision>
      <visual name="vis_lavavajillas"><pose>0 0 0.425 0 0 0</pose><geometry><box><size>0.6 0.6 0.85</size></box></geometry>
        <material><diffuse>0.8 0.8 0.82 1</diffuse><ambient>0.8 0.8 0.82 1</ambient></material></visual></link></model>

    <!-- Tacho de basura: 0.4 x 0.4 x 0.65 m -->
    <model name="tacho"><static>true</static><pose>4.2 2.65 0 0 0 0</pose><link name="l">
      <collision name="col_tacho"><pose>0 0 0.325 0 0 0</pose><geometry><box><size>0.4 0.4 0.65</size></box></geometry></collision>
      <visual name="vis_tacho"><pose>0 0 0.325 0 0 0</pose><geometry><box><size>0.4 0.4 0.65</size></box></geometry>
        <material><diffuse>0.2 0.2 0.2 1</diffuse><ambient>0.2 0.2 0.2 1</ambient></material></visual></link></model>
  </world>
</sdf>
