        <material><diffuse>0.85 0.85 0.82 1</diffuse><ambient>0.85 0.85 0.82 1</ambient></material></visual>
      <collision name="ext_s_2"><pose>4.375 -4 0.6 0 0 0</pose><geometry><box><size>12.35 0.1 1.2</size></box></geometry></collision>
      <visual name="v_ext_s_2"><pose>4.375 -4 0.6 0 0 0</pose><geometry><box><size>12.35 0.1 1.2</size></box></geometry>
        <material><diffuse>0.85 0.85 0.82 1</diffuse><ambient>0.85 0.85 0.82 1</ambient></material></visual>
