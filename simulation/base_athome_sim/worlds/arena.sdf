<?xml version="1.0"?>
<!-- ==============================================================================
     Base@Home - ARENA: una casa completa para TODAS las pruebas en simulacion (gz sim Harmonic).
     ==============================================================================
     Un solo mundo y un solo mapa (simulation/config/arena.pgm/.yaml, generado con hacer_mapa.py
     con origen (-4.5, -5.0) y 16 x 12 m). Cada prueba se configura con variables de entorno
     (ATHOME_SIM_PERSON, ATHOME_SIM_BAG, ATHOME_SIM_CUSTOMERS, ATHOME_SIM_START...) sin cambiar el
     mundo. Mapa semantico: simulation/base_athome_sim/config/arena_semantic_map.yaml.

     CASA: 14 x 10 m, X de -3.5 a 10.5, Y de -4 a 6. Paredes de 0.10 m de espesor y 1.2 m de alto.
     El robot arranca en (0, 0, yaw 0) = waypoint 'home' (living, mirando al este, hacia la puerta del comedor)
     salvo que ATHOME_SIM_START="x,y,yaw_deg" diga otra cosa (Restaurant arranca junto a la barra).

     AMBIENTES (limites interiores):
       living        X -1.0 .. 5.0   Y -4.0 .. 2.0   sofa, sillon, mesa ratona BAJA (0.35 m: invisible al lidar), mueble TV
       hall/entrada  X -3.5 .. -1.0  Y -4.0 .. 2.0   zapatero; puerta de calle CERRADA (panel) en la pared sur, X -2.7..-1.8
       dormitorio    X -3.5 .. 0.5   Y  2.0 .. 6.0   cama, mesa de luz, placard
       cocina        X  0.5 .. 5.0   Y  2.0 .. 6.0   mesada, heladera, estante, mesa (0.76 m) con 2 sillas
       comedor       X  5.0 .. 10.5  Y -1.0 .. 6.0   barra (kitchen bar) y 3 mesas con sillas (Restaurant)
       lavadero      X  5.0 .. 10.5  Y -4.0 .. -1.0  lavarropas, secarropas, tacho de basura (trash_drop), canasto

     PUERTAS (huecos; ancho / centro):
       hall <-> living          0.90 m   pared X=-1.0,  Y -1.45 .. -0.55 (centro Y=-1.0)
       hall <-> dormitorio      0.90 m   pared Y= 2.0,  X -2.725 .. -1.825 (centro X=-2.275)
       living <-> cocina        0.90 m   pared Y= 2.0,  X  2.6 .. 3.5 (centro X=3.05)
       living <-> comedor       0.90 m   pared X= 5.0,  Y  0.05 .. 0.95 (centro Y=0.5)
       comedor <-> lavadero     0.90 m   pared Y=-1.0,  X  5.325 .. 6.225 (centro X=5.775)
       calle -> hall            0.90 m   pared Y=-4.0,  X -2.7 .. -1.8, CERRADA con un panel (figura en el mapa)
     Todas de 0.90 m: por una de 0.85 m un robot de 0.88 m de diametro no pasa (lo comprueba test_arena_world.py).
     Pasillos entre muebles >= 1.0 m (comedor: 1.05 m mesa-pared, 1.7 m entre mesas, 1.475 m sillas-barra).
     Robot: radio de navegacion 0.44 m, lidar a 0.38 m (ve todo lo que cruza esa altura: la mesa ratona no).

     PUNTOS UTILES (x, y, yaw_deg) -> ver arena_semantic_map.yaml:
       home (0, 0, 0)   instruction_point (1.0, 0, 180)   door (-2.25, -3.0, -90)   hall (-2.25, -1.0, 90)
       living_room (1.5, -0.8, 0)   bedroom (-1.6, 3.0, 90)   kitchen (1.6, 2.8, 90)   table (3.4, 4.7, -90)
       shelf (1.55, 4.0, 180)   dining_room (5.8, 1.3, 0)   kitchen_bar (7.75, 4.4, 90)   laundry (6.5, -2.5, 0)
       trash_drop (9.6, -2.7, -90)
     Restaurant: ATHOME_SIM_START=7.75,4.4,-90 (junto a la barra mirando a las mesas);
       clientes sugeridos ATHOME_SIM_CUSTOMERS="6.5,3.5,right,seated;8.55,0.1,left,seated" (mesa 1 y mesa 3).
     Basura ("take out the trash", escenario normal): ATHOME_SIM_PERSON=2.6,-0.3  ATHOME_SIM_BAG=1.5,0.9,0.30
     ============================================================================== -->
<sdf version="1.9">
  <world name="arena">
    <physics name="1ms" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light type="directional" name="sol"><cast_shadows>false</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.3 0.2 -1</direction></light>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.8 0.85 0.9 1</background></scene>

    <model name="piso"><static>true</static><link name="l">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        <material><diffuse>0.55 0.5 0.45 1</diffuse><ambient>0.55 0.5 0.45 1</ambient></material></visual></link></model>

