<?xml version="1.0"?>
<!-- Mundo de evaluacion de navegacion: habitacion de 8 x 6 m con una puerta de 0.90 m en la pared oeste.
     La puerta mide el minimo de arena (RuleBook 2026.2) y deja 1 cm por lado al robot de radio 0.44 m:
     es el caso limite que evalua nav_eval.py. La bolsa y la persona las crea sim_robot. -->
<sdf version="1.9">
  <world name="nav_eval">
    <physics name="1ms" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light type="directional" name="sol"><cast_shadows>false</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.3 0.2 -1</direction></light>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.8 0.85 0.9 1</background></scene>

    <model name="piso"><static>true</static><link name="l">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        <material><diffuse>0.55 0.5 0.45 1</diffuse><ambient>0.55 0.5 0.45 1</ambient></material></visual></link></model>

    <!-- Paredes: habitacion 8 x 6 m, puerta (hueco de 1 m) en la pared oeste -->
    <model name="paredes"><static>true</static><link name="l">
      <collision name="n"><pose>1 3 0.6 0 0 0</pose><geometry><box><size>8 0.1 1.2</size></box></geometry></collision>
      <visual name="n"><pose>1 3 0.6 0 0 0</pose><geometry><box><size>8 0.1 1.2</size></box></geometry></visual>
      <collision name="s"><pose>1 -3 0.6 0 0 0</pose><geometry><box><size>8 0.1 1.2</size></box></geometry></collision>
      <visual name="s"><pose>1 -3 0.6 0 0 0</pose><geometry><box><size>8 0.1 1.2</size></box></geometry></visual>
      <collision name="e"><pose>5 0 0.6 0 0 0</pose><geometry><box><size>0.1 6 1.2</size></box></geometry></collision>
      <visual name="e"><pose>5 0 0.6 0 0 0</pose><geometry><box><size>0.1 6 1.2</size></box></geometry></visual>
      <collision name="w1"><pose>-3 1.75 0.6 0 0 0</pose><geometry><box><size>0.1 2.55 1.2</size></box></geometry></collision>
      <visual name="w1"><pose>-3 1.75 0.6 0 0 0</pose><geometry><box><size>0.1 2.55 1.2</size></box></geometry></visual>
      <collision name="w2"><pose>-3 -1.75 0.6 0 0 0</pose><geometry><box><size>0.1 2.55 1.2</size></box></geometry></collision>
      <visual name="w2"><pose>-3 -1.75 0.6 0 0 0</pose><geometry><box><size>0.1 2.55 1.2</size></box></geometry></visual>
    </link></model>

    <model name="mesa"><static>true</static><pose>1.5 -2.5 0 0 0 0</pose><link name="l">
      <collision name="c"><pose>0 0 0.38 0 0 0</pose><geometry><box><size>0.6 0.9 0.76</size></box></geometry></collision>
      <visual name="v"><pose>0 0 0.38 0 0 0</pose><geometry><box><size>0.6 0.9 0.76</size></box></geometry>
        <material><diffuse>0.45 0.3 0.15 1</diffuse><ambient>0.45 0.3 0.15 1</ambient></material></visual></link></model>

    <model name="silla_1"><static>true</static><pose>-2.0 2.3 0 0 0 0</pose><link name="l">
      <collision name="c"><pose>0 0 0.225 0 0 0</pose><geometry><box><size>0.5 0.5 0.45</size></box></geometry></collision>
      <visual name="v"><pose>0 0 0.225 0 0 0</pose><geometry><box><size>0.5 0.5 0.45</size></box></geometry>
        <material><diffuse>0.2 0.3 0.6 1</diffuse></material></visual>
      <visual name="r"><pose>0.22 0 0.65 0 0 0</pose><geometry><box><size>0.06 0.5 0.4</size></box></geometry>
        <material><diffuse>0.2 0.3 0.6 1</diffuse></material></visual></link></model>
    <model name="silla_2"><static>true</static><pose>-2.0 -2.3 0 0 0 0</pose><link name="l">
      <collision name="c"><pose>0 0 0.225 0 0 0</pose><geometry><box><size>0.5 0.5 0.45</size></box></geometry></collision>
      <visual name="v"><pose>0 0 0.225 0 0 0</pose><geometry><box><size>0.5 0.5 0.45</size></box></geometry>
        <material><diffuse>0.2 0.3 0.6 1</diffuse></material></visual>
      <visual name="r"><pose>0.22 0 0.65 0 0 0</pose><geometry><box><size>0.06 0.5 0.4</size></box></geometry>
        <material><diffuse>0.2 0.3 0.6 1</diffuse></material></visual></link></model>
  </world>
</sdf>
