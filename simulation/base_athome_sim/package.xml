<?xml version="1.0"?>
<package format="3">
  <name>base_athome_sim</name>
  <version>0.1.0</version>
  <description>Simulacion sencilla de Base@Home: reemplaza la Jetson (brazo, pan-tilt, microfono, camaras) y Nav2 con las mismas interfaces ROS 2, para probar receptionist, manipulacion y misiones sin hardware.</description>
  <maintainer email="paezemo@gmail.com">UruBots</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>hoverboard_base</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>base_athome_skills</exec_depend>
  <exec_depend>base_athome_bringup</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
